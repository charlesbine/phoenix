[Unit]
Description=Phoenix Renderer (pixlet and Python applet render loop)
After=phoenix-dashboard.service
Requires=phoenix-dashboard.service

[Service]
Type=simple
User=__PHOENIX_USER__
WorkingDirectory=__PHOENIX_DIR__
ExecStart=__PHOENIX_UV__ run phoenix render
Nice=10
Restart=always
RestartSec=5
Environment=PHOENIX_PLATFORM=serial

[Install]
WantedBy=multi-user.target
