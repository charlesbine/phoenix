[Unit]
Description=Phoenix Display (frame streaming to LED panel)
After=phoenix-dashboard.service
Requires=phoenix-dashboard.service

[Service]
Type=simple
User=__PHOENIX_USER__
WorkingDirectory=__PHOENIX_DIR__
ExecStart=__PHOENIX_UV__ run phoenix display
Nice=-5
Restart=always
RestartSec=3
Environment=PHOENIX_PLATFORM=serial

[Install]
WantedBy=multi-user.target
