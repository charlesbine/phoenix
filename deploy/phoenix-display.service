[Unit]
Description=Phoenix Display (serial frame streaming to M4)
After=phoenix-dashboard.service
Requires=phoenix-dashboard.service

[Service]
Type=simple
User=charles
WorkingDirectory=/home/charles/phoenix
ExecStart=/home/charles/.local/bin/uv run phoenix display
Restart=always
RestartSec=3
Environment=PHOENIX_PLATFORM=serial

[Install]
WantedBy=multi-user.target
