# Phoenix Configuration
# Copy this to .env and fill in your values

# Platform: "matrix" for Raspberry Pi RGB matrix, "web" for dev/web viewing
PHOENIX_PLATFORM=web

# Display settings (also configurable via dashboard at runtime)
# PHOENIX_DATA_SERVER_PORT=8000
# PHOENIX_DASHBOARD_PORT=7002

# Spotify integration (optional)
# PHOENIX_SPOTIFY_CLIENT_ID=your_client_id_here
# PHOENIX_SPOTIFY_CLIENT_SECRET=your_client_secret_here
# PHOENIX_SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090
