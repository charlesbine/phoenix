# Phoenix Configuration
# Copy to .env and fill in the values you need.

# Display backend:
#   "wled"   - ESP32 / Apollo M-1 over LAN UDP (easiest — no wiring)
#   "serial" - Adafruit Matrix Portal M4 over USB serial
#   "matrix" - Raspberry Pi direct HUB75 GPIO
#   "web"    - Browser preview only (no physical panel required)
PHOENIX_PLATFORM=web

# Serial display (when PHOENIX_PLATFORM=serial)
# PHOENIX_SERIAL_PORT=/dev/ttyACM0       # Linux; on macOS use /dev/cu.usbmodem101
# PHOENIX_SERIAL_BRIGHTNESS=255          # 0-255

# WLED / Apollo M-1 display (when PHOENIX_PLATFORM=wled)
# PHOENIX_WLED_IP=auto                   # Panel IP (e.g. 192.168.1.100) or "auto" for mDNS
# PHOENIX_WLED_PORT=21324

# Audio visualizer capture (requires the `audio` Python extra + PortAudio)
# PHOENIX_AUDIO_DEVICE=                  # PortAudio input name substring/index; blank = default

# Rendering & services
# PHOENIX_SERVICES="dashboard render display"  # Docker entrypoint; use "dashboard render" on a split brain
# PHOENIX_RENDER_WORKERS=0               # 0 = auto (min(cores, 4)); set 1 on low-RAM hosts
# PHOENIX_RENDER_WIDTH=64
# PHOENIX_RENDER_HEIGHT=64
# PHOENIX_MAGNIFICATION=5
# PHOENIX_DASHBOARD_PORT=7002
# PHOENIX_DB_PATH=                       # Optional custom SQLite path (parent dir must exist)

# Optional comma-separated hostname allowlist for the /proxy cache endpoint
# (private/loopback/link-local targets are always blocked)
# PHOENIX_PROXY_ALLOWED_HOSTS=

# Split deployment: paired serial display node (see docs/deployment.md)
# PHOENIX_NODE_DEVICE=
# PHOENIX_NODE_TOKEN_FILE=
# PHOENIX_NODE_URL=                      # Controller -> player HTTPS origin
# PHOENIX_NODE_CA_FILE=                  # Controller -> player trusted cert
# PHOENIX_NODE_BIND=                     # Player LAN listen IP
# PHOENIX_NODE_PORT=7443
# PHOENIX_NODE_PEER=                     # Player expected controller LAN IP
# PHOENIX_NODE_TLS_CERT=
# PHOENIX_NODE_TLS_KEY=

# Home Assistant integration (optional — Spotify Now Playing, Home Climate, HA auto-discovery)
# PHOENIX_HA_URL=http://homeassistant.local:8123
# PHOENIX_HA_TOKEN=
# PHOENIX_HA_MEDIA_PLAYER=               # Optional entity ID; blank = auto-detect playing media_player

# MQTT (optional — Home Assistant discovery, notifications, package alerts)
# PHOENIX_MQTT_BROKER=mqtt.local
# PHOENIX_MQTT_PORT=8883
# PHOENIX_MQTT_TLS=true
# PHOENIX_MQTT_USERNAME=
# PHOENIX_MQTT_PASSWORD=
# PHOENIX_MQTT_NOTIFY_TOPIC=phoenix/notify

# Spotify API (optional, if using direct Spotify OAuth)
# PHOENIX_SPOTIFY_CLIENT_ID=
# PHOENIX_SPOTIFY_CLIENT_SECRET=
# PHOENIX_SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090
